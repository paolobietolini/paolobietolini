---
import { json } from "astro:schema";
import type { Site } from "../lib/site";

interface Props {
  site: Site;
}

const { site } = Astro.props;
---

<header class="site-header container">
  <a class="brand" href="/">
    <span class="pb-mark" aria-hidden="true"
      ><span>{"{"}</span><span>PB</span><span>{"}"}</span></span
    >
    <span class="brand-name">{site.name}</span>
  </a>
  <nav aria-label="Main">
    {
      site.nav.map((item) => (
        <a href={item.href} class:list={{ accent: item.accent }}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
