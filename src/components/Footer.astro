---
import type { Site } from '../lib/site';

interface Props {
  site: Site;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer container-wide">
  <div class="site-footer-row">
    <p class="site-footer-brand">
      <span class="pb-mark" aria-hidden="true"><span>{'{'}</span><span>PB</span><span>{'}'}</span></span>
      <span>{site.description}</span>
    </p>
    <nav class="meta" aria-label="Elsewhere">
      {site.socials.map((s) => <a href={s.href} rel={s.rel}>{s.label}</a>)}
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
  <p class="meta">© {year} {site.name} · Built with Astro</p>
</footer>
