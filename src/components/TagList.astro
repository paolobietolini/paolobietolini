---
import { tagSlug } from '../lib/post-utils';

interface Props {
  tags: string[];
  size?: 'sm' | 'md';
}

const { tags, size = 'md' } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['tag-list', `tag-list-${size}`]}>
      {tags.map((tag) => (
        <li>
          <a class="chip" href={`/tags/${tagSlug(tag)}/`}>
            <span aria-hidden="true">#</span> {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
