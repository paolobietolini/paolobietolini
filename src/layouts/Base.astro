---
import "../../brand/tokens.css";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSite } from "../lib/site";
import { serializeJsonLd } from "../lib/structured-data";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "it";
  image?: string;
  jsonLd?: unknown;
  wide?: boolean;
}

const site = await getSite();
const {
  title,
  description = site.description,
  lang = "en",
  image = new URL("/og-default.png", Astro.site).href,
  jsonLd,
  wide = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline data-theme-script>
      (() => {
        const root = document.documentElement;
        const save = (t) => { try { localStorage.setItem("theme", t); } catch {} };
        try {
          const t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") root.dataset.theme = t;
        } catch {}
        const os = matchMedia("(prefers-color-scheme: dark)");
        const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : os.matches);
        const sync = () => {
          for (const btn of document.querySelectorAll("[data-theme-toggle]")) {
            btn.setAttribute("aria-pressed", String(isDark()));
          }
        };
        os.addEventListener("change", sync);
        document.addEventListener("DOMContentLoaded", () => {
          sync();
          for (const btn of document.querySelectorAll("[data-theme-toggle]")) {
            btn.addEventListener("click", () => {
              root.dataset.theme = isDark() ? "light" : "dark";
              save(root.dataset.theme);
              sync();
            });
          }
        });
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="theme-color"
      content="#FAFAFC"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#14121F"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={serializeJsonLd(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <Header site={site} />
    <main class:list={[wide ? "container-wide" : "container"]}>
      <slot />
    </main>
    <Footer site={site} />
  </body>
</html>
