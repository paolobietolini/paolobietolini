---
import Base from '../layouts/Base.astro';
import PostItem from '../components/PostItem.astro';
import Hero from '../components/Hero.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import About from '../components/About.astro';
import ContactCard from '../components/ContactCard.astro';
import { getSite } from '../lib/site';
import { getPosts } from '../lib/posts';
import { featured, latest } from '../lib/post-utils';
import { homeJsonLd } from '../lib/structured-data';

const site = await getSite();
const posts = await getPosts();
const picks = featured(posts);
const recent = latest(posts);
---

<Base jsonLd={homeJsonLd(site, Astro.site!.origin)} wide>
  <Hero site={site} />

  {
    picks.length > 0 && (
      <section class="home-section" aria-labelledby="featured-title">
        <p class="eyebrow meta">featured · {picks.length}</p>
        <h2 id="featured-title">Featured</h2>
        <div class="featured-grid">
          {picks.map((post) => <FeaturedCard post={post} />)}
        </div>
      </section>
    )
  }

  <section class="home-section home-latest" aria-labelledby="latest-title">
    <p class="eyebrow meta">writing</p>
    <h2 id="latest-title">Latest</h2>
    {
      recent.length ? (
        <ul class="post-list">
          {recent.map((post) => <PostItem post={post} />)}
        </ul>
      ) : (
        <p class="meta">No posts yet.</p>
      )
    }
    <p><a href="/posts/">All posts →</a></p>
  </section>

  <About site={site} />
  <ContactCard site={site} />
</Base>
