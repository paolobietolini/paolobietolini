---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/site';

const site = await getSite();
const paragraphs = site.intro.trim().split(/\n\s*\n/);
---

<Base>
  <p class="eyebrow meta">{site.tagline}</p>
  <h1>{site.name}</h1>
  <div class="intro">
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
</Base>
